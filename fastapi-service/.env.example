# GLiNER — extraction zero-shot multilingue (FR/EN)
SKILL_MODEL_NAME=urchade/gliner_multi-v2.1

# Labels passés à GLiNER à l'inférence (séparés par des virgules)
SKILL_LABELS=programming language,framework,library,database,cloud platform,tool,soft skill,methodology

# Seuil de confiance minimum (0.0 - 1.0)
SKILL_CONFIDENCE_THRESHOLD=0.4

PRELOAD_MODELS=false

# fake = test sans téléchargement | real = GLiNER (production)
SKILL_EXTRACTOR_MODE=fake

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# PRELOAD_MODELS=true charge GLiNER (NER) + le modèle d'embeddings au démarrage
# du conteneur, avant que /health/ready ne réponde "ok". Recommandé en prod/démo
# pour éviter que le premier upload de CV ne déclenche un cold start de 10+ secondes.
# En dev, false (défaut) accélère le démarrage du conteneur au prix d'un 1er appel lent.
PRELOAD_MODELS=true
