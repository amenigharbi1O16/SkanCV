# Variables d'environnement du microservice FastAPI (Option A — NER pré-entraîné)
#
# Copier vers .env pour personnaliser :
#   cp .env.example .env

# Modèle NER multilingue (FR/EN) — fine-tuné sur SkillSpan / ESCO
SKILL_MODEL_NAME=jjzha/escoxlmr_skill_extraction

# Seuil de confiance minimum (0.0 - 1.0) — rejeter le bruit en dessous
SKILL_CONFIDENCE_THRESHOLD=0.55

# true = charge les modèles au démarrage (prod) | false = à la 1ère requête (dev, réseau lent)
PRELOAD_MODELS=false

# fake = test sans HuggingFace | real = vrai NER (production)
SKILL_EXTRACTOR_MODE=real

# Modèle sentence-transformers pour le scoring (inchangé vs avant)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
